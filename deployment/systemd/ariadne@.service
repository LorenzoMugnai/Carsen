[Unit]
Description=Ariadne Knowledge MCP instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ariadne
Group=ariadne
WorkingDirectory=/opt/ariadne
Environment=ARIADNE_CONFIG_DIR=/etc/ariadne
ExecStart=/opt/ariadne/.venv/bin/ariadne serve %i --transport http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/ariadne /home/ariadne/.local/share/ariadne

[Install]
WantedBy=multi-user.target
